# Canonical public site. Preview deployment remains noindex automatically on Vercel.
SITE_URL=https://www.8ntic.com
INDEXING_ENABLED=true

# Required only for production signup. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
BETA_RATE_LIMIT_SECRET=
# On hosts other than Vercel, set only to a header overwritten by your trusted proxy.
BETA_TRUSTED_PROXY_HEADER=

# Optional verified search-console tokens.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
